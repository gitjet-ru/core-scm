# Секреты и параметры geesefs для merge-файла docker-compose.s3fs-local.yml.
# Скопируйте: cp .env.s3.example .env.s3 и подставьте реальные значения.
# Файл .env.s3 в .gitignore — не коммитьте ключи.

# --- обязательно для монтирования бакета в /data/git ---
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# --- опционально ---
# STS / временные креденшалы
# AWS_SESSION_TOKEN=

# Кастомный S3 API (без этого — AWS default).
# MinIO: S3_ENDPOINT=http://minio:9000
# Selectel (пример): S3_ENDPOINT=https://s3.gis-1.storage.selcloud.ru
# S3_ENDPOINT=

# Регион для SigV4 (для Selectel gis-1 обычно нужен).
# S3_REGION=gis-1

# 1 = path-style (MinIO). 0 = без use_path_request_style (часто Selectel / AWS virtual-hosted).
S3_USE_PATH_STYLE=1

# Самоподписанный TLS у кастомного S3: 1 = да
S3_NO_CHECK_CERT=0

# Отладка geesefs (шумные логи)
DEBUG_GEESEFS=0

# Владелец объектов в бакете (пользователь git в образе — 1000:1000)
S3FS_UID=1000
S3FS_GID=1000

# Для geesefs не используется nonempty. Если /data/git в томе конфликтует,
# лучше очистить/пересоздать volume gitea_data.

# Дополнительные флаги geesefs (через пробел)
# GEESEFS_EXTRA_OPTS=
