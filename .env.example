# Скопируйте в .env и при необходимости измените.
# docker compose подхватывает .env автоматоматически.

# Учётка и БД для Gitea (создаются скриптом db-bootstrap на Spilo/Patroni).
# Пароль же выставляется как PGPASSWORD_SUPERUSER в Spilo — для локали один общий пароль.
POSTGRES_USER=gitea
POSTGRES_PASSWORD=gitea
POSTGRES_DB=gitea

# Имя кластера Patroni (SCOPE в Spilo)
# PATRONI_SCOPE=gitjet-local

# etcd: образ собирается из ./docker/etcd (релиз github.com/etcd-io/etcd), архитектура = хост (arm64/amd64).
# ETCD_VERSION=3.4.33

# Образ Spilo с PostgreSQL 17 и Patroni (Zalando)
# SPILO_IMAGE=ghcr.io/zalando/spilo-17:4.0-p2

# Публикация Postgres на хост (для локальной разработки без контейнера приложения)
POSTGRES_PUBLISH_PORT=5432

HTTP_PUBLISH_PORT=3000
SSH_PUBLISH_PORT=2222
ROOT_URL=http://localhost:3000/
DOMAIN=localhost
SSH_DOMAIN=localhost

# External git-storage backend (MVP for bare repos only)
# local | remote | shadow
# GIT_STORAGE_BACKEND=local
# GIT_STORAGE_ENDPOINT=git-storage:9093
# GIT_STORAGE_TIMEOUTS=30s
#
# git-storage S3 backend (Selectel-compatible example)
# GIT_STORAGE_S3_ENDPOINT=s3.gis-1.storage.selcloud.ru
# GIT_STORAGE_S3_REGION=gis-1
# GIT_STORAGE_S3_BUCKET=git-jet-local
# GIT_STORAGE_S3_PREFIX=repos
# GIT_STORAGE_S3_USE_SSL=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
