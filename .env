# Локальный стенд (docker compose). Не использовать в продакшене.

# Учётка и БД для Gitea (db-bootstrap + подключение приложения).
# Тот же пароль — суперпользователь postgres в Spilo (PGPASSWORD_SUPERUSER).
POSTGRES_USER=gitea
POSTGRES_PASSWORD=gitea
POSTGRES_DB=gitea

# Patroni: SCOPE кластера в Spilo
PATRONI_SCOPE=gitjet-local

# etcd 3.4.x собирается из docker/etcd (нативный arm64/amd64). Не тянуть gcr.io/etcd — под arm64 ломался mmap.
# После смены версии или паник: docker compose down && docker volume rm core-scm_etcd_data
# ETCD_VERSION=3.4.33

# Образ Spilo: PostgreSQL 17 + Patroni
SPILO_IMAGE=ghcr.io/zalando/spilo-17:4.0-p2

# Postgres на хосте (для psql/DBeaver с машины разработчика)
POSTGRES_PUBLISH_PORT=5432

# Веб и SSH Gitea/GitJet с хоста
HTTP_PUBLISH_PORT=3000
SSH_PUBLISH_PORT=22

# Должно совпадать с HTTP_PUBLISH_PORT и тем, как открываете сайт в браузере
ROOT_URL=http://localhost:3000/
DOMAIN=localhost
SSH_DOMAIN=localhost

# SSH внутри контейнера (см. шаблон docker); публикация наружу — SSH_PUBLISH_PORT
DISABLE_SSH=false
SSH_PORT=22
SSH_LISTEN_PORT=22
